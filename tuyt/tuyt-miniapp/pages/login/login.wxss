/* 登录页样式 */
.login-page {
  min-height: 100vh;
  background: linear-gradient(135deg, #1890FF 0%, #096DD9 100%);
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 120px;
}
.login-header {
  margin-bottom: 48px;
}
.logo-area {
  display: flex;
  flex-direction: column;
  align-items: center;
}
.logo-icon {
  font-size: 64px;
  margin-bottom: 16px;
}
.app-name {
  font-size: 24px;
  color: #fff;
  font-weight: 600;
  margin-bottom: 8px;
}
.app-sub {
  font-size: 13px;
  color: rgba(255,255,255,0.7);
}
.login-form {
  width: 85%;
  max-width: 360px;
  background: #fff;
  border-radius: 12px;
  padding: 32px 24px;
  box-shadow: 0 8px 24px rgba(0,0,0,0.12);
}
.input-group {
  display: flex;
  align-items: center;
  background: #f5f5f5;
  border-radius: 8px;
  padding: 0 12px;
  margin-bottom: 16px;
  height: 48px;
}
.input-icon {
  font-size: 18px;
  margin-right: 10px;
}
.input-field {
  flex: 1;
  font-size: 15px;
  color: #333;
  height: 100%;
}
.login-btn {
  width: 100%;
  height: 46px;
  line-height: 46px;
  background: linear-gradient(135deg, #1890FF, #096DD9);
  color: #fff;
  border-radius: 8px;
  font-size: 16px;
  font-weight: 500;
  margin-top: 12px;
  border: none;
}
.login-btn[disabled] {
  background: #b0d4ff;
  color: #fff;
}
.demo-hint {
  text-align: center;
  margin-top: 16px;
  font-size: 12px;
  color: #bbb;
}
