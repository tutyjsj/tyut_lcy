/* 任务详情 */
.detail-header {
  display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px;
}
.detail-time { font-size: 12px; color: #999; }
.detail-title {
  font-size: 18px; font-weight: 600; color: #333; margin-bottom: 10px;
}
.detail-body {
  font-size: 14px; color: #666; line-height: 1.6; margin-bottom: 16px;
}
.detail-grid {
  display: flex; flex-wrap: wrap; border-top: 1px solid #f0f0f0; padding-top: 12px;
}
.detail-item { width: 50%; padding: 8px 0; }
.d-label { font-size: 12px; color: #999; display: block; margin-bottom: 2px; }
.d-value { font-size: 14px; color: #333; }
.d-value.link { color: #1890FF; }
.action-area {
  margin: 20px 16px; display: flex; gap: 12px;
}
.action-btn {
  flex: 1; height: 44px; line-height: 44px; text-align: center;
  border-radius: 8px; font-size: 15px; border: none; color: #fff;
}
.action-btn.primary { background: #1890FF; }
.action-btn.warn { background: #FA8C16; }
