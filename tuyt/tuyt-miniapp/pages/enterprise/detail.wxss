/* 企业详情 */
.ent-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px; }
.ent-title { font-size: 18px; font-weight: 600; color: #333; }
.detail-grid { display: flex; flex-wrap: wrap; border-top: 1px solid #f0f0f0; padding-top: 12px; }
.detail-item { width: 50%; padding: 8px 0; }
.detail-item.full-width { width: 100%; }
.d-label { font-size: 12px; color: #999; display: block; margin-bottom: 2px; }
.d-value { font-size: 14px; color: #333; display: block; }
.section-title { font-size: 15px; font-weight: 600; padding: 16px 16px 8px; }
.p-mini { padding: 12px 14px; margin: 0 16px 8px; }
.p-mini-row { display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 4px; }
.p-mini-desc { flex: 1; font-size: 13px; color: #333; margin-right: 8px; }
.p-mini-time { font-size: 11px; color: #bbb; }
