/* 问题上报 */
.card { margin: 12px 16px; }
.form-input {
  height: 42px;
  background: #f9f9f9;
  border-radius: 6px;
  padding: 0 12px;
  font-size: 14px;
  width: 100%;
  box-sizing: border-box;
}
.form-textarea {
  min-height: 100px;
  background: #f9f9f9;
  border-radius: 6px;
  padding: 12px;
  font-size: 14px;
  width: 100%;
  box-sizing: border-box;
}
.form-picker {
  height: 42px;
  line-height: 42px;
  background: #f9f9f9;
  border-radius: 6px;
  padding: 0 12px;
  font-size: 14px;
  color: #333;
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.upload-area {
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
}
.upload-img {
  width: 80px;
  height: 80px;
  border-radius: 6px;
  background: #f0f0f0;
}
.upload-btn {
  width: 80px;
  height: 80px;
  border: 1px dashed #d9d9d9;
  border-radius: 6px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32px;
  color: #ccc;
}
.submit-btn {
  width: 100%;
  height: 44px;
  line-height: 44px;
  background: #1890FF;
  color: #fff;
  border-radius: 8px;
  font-size: 16px;
  margin-top: 16px;
  border: none;
}
.submit-btn[disabled] {
  background: #b0d4ff;
}
