/* 问题详情 */
.detail-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12px;
}
.detail-time { font-size: 12px; color: #999; }
.detail-desc {
  font-size: 16px;
  font-weight: 500;
  color: #333;
  line-height: 1.6;
  margin-bottom: 16px;
}
.detail-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 0;
  border-top: 1px solid #f0f0f0;
  padding-top: 12px;
}
.detail-item {
  width: 50%;
  padding: 8px 0;
}
.d-label {
  font-size: 12px;
  color: #999;
  display: block;
  margin-bottom: 2px;
}
.d-value { font-size: 14px; color: #333; }

.section-title {
  font-size: 15px;
  font-weight: 600;
  padding: 16px;
}
.log-item {
  display: flex;
  padding: 12px 16px 12px 24px;
  position: relative;
}
.log-dot {
  width: 8px;
  height: 8px;
  border-radius: 50%;
  background: #1890FF;
  margin-top: 6px;
  margin-right: 12px;
  flex-shrink: 0;
}
.log-dot.warn { background: #FA8C16; }
.log-dot.close { background: #999; }
.log-dot.dispatch { background: #52C41A; }
.log-content { flex: 1; }
.log-text { font-size: 13px; color: #333; line-height: 1.5; display: block; }
.log-time { font-size: 11px; color: #bbb; margin-top: 4px; display: block; }
