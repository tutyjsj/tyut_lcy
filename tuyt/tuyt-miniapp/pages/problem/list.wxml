<!-- 问题列表 -->
<view class="container">
  <!-- 搜索栏 -->
  <view class="search-bar">
    <view class="search-input-container">
      <text class="search-icon">🔍</text>
      <input class="search-input" placeholder="搜索事发企业/问题描述" value="{{keyword}}" bindinput="onKeyword" />
    </view>
    <view class="search-filter" bindtap="showFilter">筛选</view>
  </view>

  <!-- 筛选展开区 -->
  <view class="filter-panel" wx:if="{{showFilterPanel}}">
    <picker mode="selector" range="{{statusOptions}}" range-key="label" bindchange="onStatusChange">
      <view class="filter-item">{{selectedStatusLabel || '全部状态'}} ▼</view>
    </picker>
    <picker mode="selector" range="{{levelOptions}}" range-key="label" bindchange="onLevelChange">
      <view class="filter-item">{{selectedLevelLabel || '全部等级'}} ▼</view>
    </picker>
    <picker mode="selector" range="{{typeOptions}}" range-key="label" bindchange="onTypeChange">
      <view class="filter-item">{{selectedTypeLabel || '全部类型'}} ▼</view>
    </picker>
    <button class="filter-apply" bindtap="applyFilter">应用</button>
  </view>

  <!-- 上报按钮 -->
  <view class="report-btn-area">
    <button class="report-btn" bindtap="goReport">+ 上报问题</button>
  </view>

  <!-- 列表 -->
  <view wx:if="{{list.length===0&&!loading}}" class="empty">
    <text class="empty-text">暂无问题</text>
  </view>
  <view wx:for="{{list}}" wx:key="id" class="card problem-card" bindtap="goDetail" data-id="{{item.id}}">
    <view class="p-row1">
      <text class="p-desc ellipsis">{{item.problemDesc || '无描述'}}</text>
      <text class="tag {{item.statusClass}}">{{item.statusLabel}}</text>
    </view>
    <view class="p-row2">
      <text class="p-level tag {{item.levelClass}}">{{item.levelLabel}}</text>
      <text class="p-type">{{item.typeLabel}}</text>
    </view>
    <view class="p-row3">
      <text class="p-enterprise ellipsis">{{item.enterpriseName}}</text>
      <text class="p-time">{{item.alarmTime}}</text>
    </view>
  </view>
  <view class="loadmore" wx:if="{{list.length>0}}">{{hasMore ? '上拉加载更多' : '已全部加载'}}</view>
</view>
