/* 个人中心 */
.profile-header {
  background: linear-gradient(135deg, #1890FF, #096DD9);
  padding: 32px 24px;
  display: flex;
  align-items: center;
  gap: 16px;
}
.avatar {
  width: 56px; height: 56px; border-radius: 50%;
  background: rgba(255,255,255,0.2);
  display: flex; align-items: center; justify-content: center;
  font-size: 28px;
}
.user-text { display: flex; flex-direction: column; gap: 4px; }
.user-name { font-size: 18px; color: #fff; font-weight: 600; }
.user-role { font-size: 13px; color: rgba(255,255,255,0.7); }

.menu-section {
  margin: 12px 16px;
  background: #fff;
  border-radius: 10px;
  overflow: hidden;
}
.menu-item {
  display: flex;
  align-items: center;
  padding: 16px;
  border-bottom: 1px solid #f5f5f5;
}
.menu-item:last-child { border-bottom: none; }
.menu-icon { font-size: 20px; margin-right: 12px; }
.menu-text { flex: 1; font-size: 15px; color: #333; }
.menu-arrow { font-size: 18px; color: #ccc; }

.logout-area { padding: 30px 24px; }
.logout-btn {
  width: 100%; height: 44px; line-height: 44px;
  background: #fff; color: #FF4D4F; border: 1px solid #FFCCC7;
  border-radius: 8px; font-size: 15px; text-align: center;
}
